{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell (@NowoUiKit/demo_platform/layout.html.twig):
    the same top bar, aside, content width, theme and footer as every other nowo-tech bundle demo. This file only
    declares the demo (nowo_ui_demo_platform). It is also the host layout of the runtime env manage pages
    (nowo_ui_kit.layouts). -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set nowo_ui_demo_platform = {
    bundle: 'Runtime Env',
    home_route: 'demo_home',
    repository: 'https://github.com/nowo-tech/RuntimeEnvBundle',
    translation_domain: false,
    nav: [
        {label: 'Home', route: 'demo_home', section: 'Demo'},
        {label: 'Manage env vars', route: 'nowo_runtime_env_index', active: ['nowo_runtime_env*'], section: 'Runtime Env admin'},
    ],
} %}

{% block nowo_ui_document_title %}{% block title %}Runtime Env Demo{% endblock %} — Symfony 8{% endblock %}
