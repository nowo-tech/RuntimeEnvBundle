{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN). It is also the host layout of the runtime env manage pages
    (nowo_ui_kit.layouts.admin). The header menu lists the demo pages with the active item. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}Runtime Env Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route')|default('') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">Runtime Env Bundle Demo</a>
        <nav class="nowo-ui-menu" aria-label="Demo">
            <a class="nowo-ui-link" href="{{ path('demo_home') }}"{% if _route == 'demo_home' %} aria-current="page"{% endif %}>Home</a>
            <a class="nowo-ui-link" href="{{ path('nowo_runtime_env_index') }}"{% if _route starts with 'nowo_runtime_env' %} aria-current="page"{% endif %}>Manage env vars</a>
        </nav>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
