{% extends 'base.html.twig' %}

{% block title %}Home - Runtime Env Demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'Runtime Env Bundle – Demo',
        intro: 'Store selected application environment variables in MySQL with values encrypted at rest via nowo-tech/doctrine-encrypt-bundle (#[Encrypted]).',
    }) }}
{% endblock %}

{% block body %}
    <p class="nowo-ui-muted">
        FrankenPHP mode: <strong>worker</strong> by default (<code>FRANKENPHP_MODE</code>).
        Edits in the CRUD apply on the next request without restarting the worker.
    </p>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">Manage</h2></div>
        <div class="nowo-ui-card__body">
            <p>Create or edit variables (names like <code>MY_API_TOKEN</code>). List view masks values.</p>
            <a class="nowo-ui-btn nowo-ui-btn--primary" href="{{ path('nowo_runtime_env_index') }}">Open /_runtime_env</a>
        </div>
    </section>

    <section class="nowo-ui-card">
        <div class="nowo-ui-card__header"><h2 class="nowo-ui-card__title">RuntimeEnvBag sample</h2></div>
        <div class="nowo-ui-card__body">
            <p>Reads <code>DEMO_SAMPLE_VALUE</code> via <code>RuntimeEnvBag</code> (not <code>getenv</code>).</p>
            {% if has_sample %}
                <p>Value: <code>{{ sample }}</code></p>
            {% else %}
                <p class="nowo-ui-muted">No <code>DEMO_SAMPLE_VALUE</code> yet — create it in the manage UI, then reload this page.</p>
            {% endif %}
        </div>
    </section>
{% endblock %}
