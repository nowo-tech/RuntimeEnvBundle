{% extends 'base.html.twig' %}

{% block title %}Home - Runtime Env Demo{% endblock %}

{% block body %}
<div class="card shadow-sm mb-4">
    <div class="card-header">
        <h2 class="mb-0">Runtime Env Bundle – Demo</h2>
    </div>
    <div class="card-body">
        <p>
            Store selected application environment variables in MySQL with values encrypted at rest
            via <code>nowo-tech/doctrine-encrypt-bundle</code> (<code>#[Encrypted]</code>).
        </p>
        <p class="mb-0">
            FrankenPHP mode: <strong>worker</strong> by default (<code>FRANKENPHP_MODE</code>).
            Edits in the CRUD apply on the next request without restarting the worker.
        </p>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header"><h3 class="mb-0">Manage</h3></div>
    <div class="card-body">
        <p>Create or edit variables (names like <code>MY_API_TOKEN</code>). List view masks values.</p>
        <a class="btn btn-primary" href="{{ path('nowo_runtime_env_index') }}">Open /_runtime_env</a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header"><h3 class="mb-0">RuntimeEnvBag sample</h3></div>
    <div class="card-body">
        <p>Reads <code>DEMO_SAMPLE_VALUE</code> via <code>RuntimeEnvBag</code> (not <code>getenv</code>).</p>
        {% if has_sample %}
            <p>Value: <code>{{ sample }}</code></p>
        {% else %}
            <p class="text-muted mb-0">No <code>DEMO_SAMPLE_VALUE</code> yet — create it in the manage UI, then reload this page.</p>
        {% endif %}
    </div>
</div>
{% endblock %}
