{#
  Runtime env variables (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from
  RuntimeEnvPageFactory::index(): header runtime_env.index.title / subtitle with the action New variable; columns name,
  value (always masked), description, enabled; rows = list<RuntimeEnvVariable>; row actions Edit / Delete (POST + CSRF
  FormView behind a Confirm); Pagination (web_ui.list_page_size); EmptyState runtime_env.index.empty with New variable).
  Data block filled: nowo_ui_list_row (cells). The stored value is never rendered: the value cell prints a fixed mask.
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoRuntimeEnvBundle' %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    <td class="{{ _cell }}" data-label="{{ 'runtime_env.form.name'|trans }}" data-required="1">
        <code class="{{ nowo_ui_class('code', _b) }}">{{ row.name }}</code>
    </td>
    <td class="{{ _cell }}" data-label="{{ 'runtime_env.form.value'|trans }}">
        <code class="{{ nowo_ui_class('code', _b) }}" title="{{ 'runtime_env.index.value_masked'|trans }}" data-testid="runtime-env-masked-value">••••••••</code>
    </td>
    <td class="{{ _cell }}" data-label="{{ 'runtime_env.form.description'|trans }}" data-nowo-ui-priority="2">
        {% if row.description is empty %}
            <span class="{{ nowo_ui_class('muted', _b) }}">—</span>
        {% else %}
            {{ row.description }}
        {% endif %}
    </td>
    <td class="{{ _cell }}" data-label="{{ 'runtime_env.form.enabled'|trans }}">
        {% if row.enabled %}
            <span class="{{ nowo_ui_class('badge_success', _b) }}">{{ 'runtime_env.index.enabled_yes'|trans }}</span>
        {% else %}
            <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ 'runtime_env.index.enabled_no'|trans }}</span>
        {% endif %}
    </td>
{% endblock %}
