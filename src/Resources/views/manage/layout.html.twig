<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Runtime Env{% endblock %}</title>
    <style>
        body { font-family: system-ui, sans-serif; margin: 1.5rem; color: #1a1a1a; background: #f7f7f5; }
        .nowo-ui-page-header { margin-bottom: 1.25rem; }
        .nowo-ui-table { width: 100%; border-collapse: collapse; background: #fff; }
        .nowo-ui-table th, .nowo-ui-table td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
        .nowo-ui-btn { display: inline-block; padding: .4rem .8rem; text-decoration: none; background: #222; color: #fff; border: 0; cursor: pointer; }
        .nowo-ui-flash { padding: .5rem .75rem; margin-bottom: .75rem; background: #e8f5e9; }
        .nowo-ui-flash-error { background: #fdecea; }
        code { font-size: .9em; }
    </style>
</head>
<body>
{% block body %}{% endblock %}
</body>
</html>
